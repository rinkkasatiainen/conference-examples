{
  "name": "cfb-test-7",
  "version": "1.0.0",
  "description": "T-7: Loader components — fetch stubbing for step-7",
  "type": "module",
  "scripts": {
    "test": "web-test-runner \"test/**/*.test.js\" --node-resolve --config test/web-test-runner.config.mjs && npm run test:store:real",
    "test:store:fake": "web-test-runner test/*.contract.test.js --node-resolve --config test/web-test-runner.config.mjs",
    "test:store:real": "web-test-runner test/*.contract.test.js --config test/web-test-runner.store-real.config.mjs",
    "test:watch": "web-test-runner \"test/**/*.test.js\" --node-resolve --watch",
    "test:manual": "web-test-runner \"test/**/*.test.js\" --node-resolve --config test/web-test-runner.config.mjs --manual",
    "test:specific": "web-test-runner --files=test/**/*${PATTERN:-${npm_config_pattern:-*}}*.test.js --node-resolve --config test/web-test-runner.config.mjs"
  },
  "devDependencies": {
    "chai": "^5.2.0",
    "msw": "^2.7.0",
    "@web/dev-server-import-maps": "^0.2.1",
    "@web/test-runner": "^0.19.0"
  },
  "msw": {
    "workerDirectory": [
      ""
    ]
  }
}